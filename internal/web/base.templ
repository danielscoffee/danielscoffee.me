package web

// siteHead renders the shared head. Share tags go on every indexable page;
// the canonical, og:url, and og:image need an absolute URL, so they appear
// only when SITE_URL is configured. Error pages pass indexable=false.
templ siteHead(pageTitle string, pageDescription string, indexable bool) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width,initial-scale=1"/>
	<title>{ pageTitle }</title>
	<meta name="description" content={ pageDescription }/>
	if indexable {
		if canonical := canonicalURL(ctx); canonical != "" {
			<link rel="canonical" href={ templ.SafeURL(canonical) }/>
			<meta property="og:url" content={ canonical }/>
			<meta property="og:image" content={ absoluteURL(ctx, shareImagePath) }/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content={ shareImageAlt }/>
		}
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content={ siteName }/>
		<meta property="og:title" content={ pageTitle }/>
		<meta property="og:description" content={ pageDescription }/>
		<meta name="twitter:card" content="summary_large_image"/>
	}
	<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
	<link rel="preload" href="/assets/fonts/source-serif-4-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
	<link rel="preload" href="/assets/fonts/source-sans-3-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
	<link href="/assets/css/output.css?v=2" rel="stylesheet"/>
	<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS"/>
	<script src="/assets/js/theme-init.js?v=2"></script>
}

// crumbLabel carries a crumb in three sizes; crumbs-fit.js shows the longest
// that keeps the trail on the wordmark's row. Screen readers always hear the
// full label.
templ crumbLabel(label string) {
	<span class="crumb-full" aria-hidden="true">{ label }</span>
	<span class="crumb-short" aria-hidden="true">{ shortLabel(label) }</span>
	<span class="crumb-tiny" aria-hidden="true">{ tinyLabel(label) }</span>
	<span class="sr-only">{ label }</span>
}

templ Base(pageTitle string, pageDescription string, section string) {
	@BaseTrail(pageTitle, pageDescription, section, nil) {
		{ children... }
	}
}

// BaseTrail is Base with crumbs after the section in the masthead
// breadcrumb, for pages nested deeper than a section index.
templ BaseTrail(pageTitle string, pageDescription string, section string, trail []Crumb) {
	<!DOCTYPE html>
	<html lang="en" class="h-full" data-theme="system">
		<head>
			@siteHead(pageTitle+pageTitleSuffix, pageDescription, section != "")
			<script defer src="/assets/js/theme-toggle.js?v=3"></script>
			<script defer src="/assets/js/search.js?v=2"></script>
			<script defer src="/assets/js/code-copy.js?v=1"></script>
			<script defer src="/assets/js/crumbs-fit.js?v=1"></script>
		</head>
		<body class="site-shell">
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header class="site-masthead">
				<div class="masthead-inner">
					<a href="/" class="site-brand">danielscoffee</a>
					if section != "" {
						<nav class="site-crumbs" aria-label="Breadcrumb">
							<ol class="crumb-list">
								<li class="crumb">
									<span class="crumb-sep" aria-hidden="true">/</span>
									if isCurrentPath(ctx, "/"+section) {
										<span class="site-section" data-section={ section } aria-current="page">
											@crumbLabel(section)
										</span>
									} else {
										<a href={ templ.SafeURL("/" + section) } class="crumb-link site-section" data-section={ section }>
											@crumbLabel(section)
										</a>
									}
								</li>
								for _, crumb := range trail {
									<li class="crumb">
										<span class="crumb-sep" aria-hidden="true">/</span>
										<a href={ templ.SafeURL(crumb.Href) } class="crumb-link">
											@crumbLabel(crumb.Label)
										</a>
									</li>
								}
							</ol>
						</nav>
					}
					<div id="header-actions" class="header-actions">
						<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Theme" aria-live="polite" data-theme-storage-key="theme-preference">Theme</button>
						<button class="theme-toggle search-trigger" type="button" id="search-trigger" aria-label="Open search">Search <span class="search-kbd">Ctrl+K</span></button>
					</div>
				</div>
			</header>
			<main id="main-content" class="site-container">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="footer-inner">
					<span>danielscoffee</span>
					<nav aria-label="Footer links">
						<a class="footer-action-link" href="/rss.xml">RSS</a>
						<a class="footer-action-link" href="https://github.com/danielscoffee" rel="noreferrer">GitHub</a>
						<a class="footer-action-link" href="https://www.linkedin.com/in/daniel-reis-santos/" rel="noreferrer">LinkedIn</a>
					</nav>
				</div>
			</footer>

			<dialog id="search-modal" class="search-modal" aria-labelledby="search-title">
				<div class="search-modal-inner">
					<h2 id="search-title" class="sr-only">Search site</h2>
					<div class="search-bar">
						<svg class="search-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false"><circle cx="7" cy="7" r="4.75"></circle><path d="M10.5 10.5 14 14"></path></svg>
						<label for="search-input" class="sr-only">Search posts and projects</label>
						<input id="search-input" class="search-input" type="search" placeholder="Search posts and projects" autocomplete="off"/>
						<form method="dialog" class="search-close-form">
							<button class="search-close" type="submit" aria-label="Close search">
								<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 4l8 8"></path><path d="M12 4l-8 8"></path></svg>
							</button>
						</form>
					</div>
					<p class="search-hint">Filters: <code>blog</code> or <code>projects</code>. Press Esc to close.</p>
					<ul id="search-results" class="search-results" aria-live="polite"></ul>
				</div>
			</dialog>
		</body>
	</html>
}
