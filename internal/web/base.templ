package web

// siteHead renders the shared head. Share tags go on every indexable page;
// the canonical, og:url, and og:image need an absolute URL, so they appear
// only when SITE_URL is configured. Error pages pass indexable=false.
templ siteHead(pageTitle string, pageDescription string, indexable bool) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width,initial-scale=1"/>
	<title>{ pageTitle }</title>
	<meta name="description" content={ pageDescription }/>
	if indexable {
		if canonical := canonicalURL(ctx); canonical != "" {
			<link rel="canonical" href={ templ.SafeURL(canonical) }/>
			<meta property="og:url" content={ canonical }/>
			<meta property="og:image" content={ absoluteURL(ctx, shareImagePath) }/>
			<meta property="og:image:width" content="1200"/>
			<meta property="og:image:height" content="630"/>
			<meta property="og:image:alt" content={ shareImageAlt }/>
		}
		<meta property="og:type" content="website"/>
		<meta property="og:site_name" content={ siteName }/>
		<meta property="og:title" content={ pageTitle }/>
		<meta property="og:description" content={ pageDescription }/>
		<meta name="twitter:card" content="summary_large_image"/>
	}
	<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml"/>
	<link rel="preload" href="/assets/fonts/source-serif-4-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
	<link rel="preload" href="/assets/fonts/source-sans-3-regular.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
	<link href="/assets/css/output.css?v=2" rel="stylesheet"/>
	<link rel="alternate" type="application/rss+xml" href="/rss.xml" title="RSS"/>
	<script src="/assets/js/theme-init.js?v=2"></script>
}

templ Base(pageTitle string, pageDescription string, section string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full" data-theme="system">
		<head>
			@siteHead(pageTitle+pageTitleSuffix, pageDescription, section != "")
			<script defer src="/assets/js/theme-toggle.js?v=2"></script>
			<script defer src="/assets/js/search.js?v=2"></script>
			<script defer src="/assets/js/code-copy.js?v=1"></script>
		</head>
		<body class="site-shell">
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header class="site-masthead">
				<div class="masthead-inner">
					if section != "" {
						<a href={ templ.SafeURL("/" + section) } class="site-section" data-section={ section }>{ section }</a>
					} else {
						<a href="/" class="site-section">danielscoffee</a>
					}
					<div id="header-actions" class="header-actions">
						<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Theme" aria-live="polite" data-theme-storage-key="theme-preference">Theme</button>
						<button class="theme-toggle search-trigger" type="button" id="search-trigger" aria-label="Open search">Search <span class="search-kbd">Ctrl+K</span></button>
						<a href={ templ.SafeURL(parentPath(ctx)) } class="site-back" aria-label="Back">
							<svg class="site-back-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 8H2.5"></path><path d="M7 3.5 2.5 8 7 12.5"></path></svg>
						</a>
					</div>
				</div>
			</header>
			<main id="main-content" class="site-container">
				{ children... }
			</main>
			<footer class="site-footer">
				<div class="footer-inner">
					<span>danielscoffee</span>
					<nav aria-label="Footer links">
						<a class="footer-action-link" href="/rss.xml">RSS</a>
						<a class="footer-action-link" href="https://github.com/danielscoffee" rel="noreferrer">GitHub</a>
						<a class="footer-action-link" href="https://www.linkedin.com/in/daniel-reis-santos/" rel="noreferrer">LinkedIn</a>
					</nav>
				</div>
			</footer>

			<dialog id="search-modal" class="search-modal" aria-labelledby="search-title">
				<div class="search-modal-inner">
					<div class="search-dialog-header">
						<h2 id="search-title">Search site</h2>
						<form method="dialog"><button class="search-close" type="submit">Close</button></form>
					</div>
					<label for="search-input" class="search-label">Search posts and projects</label>
					<input id="search-input" class="search-input" type="search" placeholder="Try: blog accessibility" autocomplete="off"/>
					<p class="search-hint">Filters: <code>blog</code> or <code>projects</code>. Press Esc to close.</p>
					<ul id="search-results" class="search-results" aria-live="polite"></ul>
				</div>
			</dialog>
		</body>
	</html>
}
