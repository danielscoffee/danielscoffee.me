package web

import (
	"strconv"

	"github.com/danielscoffee/danielscoffee.me/internal/content"
)

templ PageIntro(title, subtitle string) {
	<header class="page-intro">
		<h1 class="page-title">{ title }</h1>
		<p class="page-subtitle">{ subtitle }</p>
	</header>
}

templ TagPageIntro(tag, subtitle string) {
	<header class="page-intro">
		<h1 class="page-title">Tagged with <span class="tag-emphasis">{ tag }</span></h1>
		<p class="page-subtitle">{ subtitle }</p>
	</header>
}

templ HomePage(posts []content.Post) {
	@Base("Daniel's Site", "Personal website and blog") {
		@PageIntro("Daniel's Site", "Personal notes on software, projects, and experiments.")
		<section class="section-block">
			<h2 class="section-title">Recent posts</h2>
			@PostList(posts)
		</section>
	}
}

templ BlogIndexPage(posts []content.Post) {
	@Base("Blog", "All blog posts") {
		@PageIntro("Blog", "All writing in one place.")
		<section class="section-block">
			<h2 class="section-title">Latest entries</h2>
			@PostList(posts)
		</section>
	}
}

templ ArticleHeader(title, date string) {
	<header class="article-header post-header">
		<h1 class="article-title post-title">{ title }</h1>
		if date != "" {
			@EditorialDate(date)
		}
	</header>
}

templ AboutPage(page content.Page) {
	@Base(page.Title, page.Summary) {
		<article class="article-shell post-prose">
			@ArticleHeader(page.Title, "")
			<div class="article-body">
				@templ.Raw(string(page.BodyHTML))
			</div>
		</article>
	}
}

templ ProjectsIndexPage(projects []content.Project) {
	@Base("Projects", "Project notes and builds") {
		@PageIntro("Projects", "Build logs, notes, and shipped experiments.")
		<section class="section-block">
			@ProjectList(projects)
		</section>
	}
}

templ ProjectDetailPage(project content.Project) {
	@Base(project.Title, project.Summary) {
		<article class="article-shell post-prose">
			@ArticleHeader(project.Title, project.Date)
			<div class="article-body">
				@templ.Raw(string(project.BodyHTML))
			</div>
		</article>
		if len(project.SubPosts) > 0 {
			<section class="section-block">
				<h2 class="section-title">Devlog &amp; notes</h2>
				@ProjectSubPostGrid(project)
			</section>
		}
	}
}

templ ProjectSubPostGrid(project content.Project) {
	<ul class="project-subposts-grid" data-count={ strconv.Itoa(len(project.SubPosts)) }>
		for _, sub := range project.SubPosts {
			<li class="project-subpost-card">
				<a class="project-subpost-link" href={ templ.SafeURL("/projects/" + project.Slug + "/" + sub.Slug) }>
					<h3 class="project-subpost-title">{ sub.Title }</h3>
					if sub.Summary != "" {
						<p class="project-subpost-summary">{ sub.Summary }</p>
					}
					<div class="project-subpost-date">@EditorialDate(sub.Date)</div>
				</a>
			</li>
		}
	</ul>
}

templ ProjectSubPostPage(project content.Project, sub content.ProjectSubPost) {
	@Base(sub.Title, sub.Summary) {
		<nav class="project-subpost-breadcrumb">
			<a class="project-subpost-back" href={ templ.SafeURL("/projects/" + project.Slug) }>&larr; { project.Title }</a>
		</nav>
		<article class="article-shell post-prose">
			@ArticleHeader(sub.Title, sub.Date)
			<div class="article-body">
				@templ.Raw(string(sub.BodyHTML))
			</div>
		</article>
	}
}

templ TagPage(tag string, posts []content.Post) {
	@Base("Tag: "+tag, "Posts filtered by tag") {
		@TagPageIntro(tag, "Filtered writing by topic.")
		<section class="section-block">
			<h2 class="section-title">Posts</h2>
			if len(posts) == 0 {
				<p class="empty-state">No posts found for this tag yet.</p>
			} else {
				@PostList(posts)
			}
		</section>
	}
}

templ EditorialDate(date string) {
	<time class="editorial-date" datetime={ date }>{ date }</time>
}

templ PostTags(tags []string) {
	if len(tags) > 0 {
		<ul class="tag-list">
			for _, tag := range tags {
				<li><a class="tag-chip" href={ templ.SafeURL("/tag/" + tag) }>{ tag }</a></li>
			}
		</ul>
	}
}

templ ProjectTags(tags []string) {
	if len(tags) > 0 {
		<ul class="tag-list">
			for _, tag := range tags {
				<li><a class="tag-chip" href={ templ.SafeURL("/projects?tag=" + tag) }>{ tag }</a></li>
			}
		</ul>
	}
}

templ PostList(posts []content.Post) {
	<ul class="editorial-list post-list">
		for _, post := range posts {
			<li class="editorial-card post-item">
				<h3 class="editorial-title"><a class="editorial-link post-link" href={ templ.SafeURL("/post/" + post.Slug) }>{ post.Title }</a></h3>
				<p class="editorial-summary post-summary">{ post.Summary }</p>
				<div class="editorial-meta post-meta-row">
					@EditorialDate(post.Date)
					@PostTags(post.Tags)
				</div>
			</li>
		}
	</ul>
}

templ ProjectList(projects []content.Project) {
	if len(projects) == 0 {
		<p class="empty-state">No projects found for this tag yet.</p>
	} else {
	<ul class="editorial-list project-list">
		for _, project := range projects {
			<li class="editorial-card project-item">
				<h2 class="editorial-title"><a class="editorial-link project-link" href={ templ.SafeURL("/projects/" + project.Slug) }>{ project.Title }</a></h2>
				<p class="editorial-summary project-summary">{ project.Summary }</p>
				<div class="editorial-meta post-meta-row">
					@EditorialDate(project.Date)
					@ProjectTags(project.Tags)
				</div>
			</li>
		}
	</ul>
	}
}

templ BlogPostPage(post content.Post) {
	@Base(post.Title, post.Summary) {
		<article class="article-shell post-prose">
			@ArticleHeader(post.Title, post.Date)
			<div class="article-body">
				@templ.Raw(string(post.BodyHTML))
			</div>
		</article>
	}
}

templ NotFoundPage() {
	@Base("Page not found", "The requested page could not be found") {
		<section class="error-page">
			<p class="page-subtitle">404</p>
			@PageIntro("Page not found", "This page wandered off, or the link is wrong.")
			<a class="site-nav-link" href="/blog">Back to blog</a>
		</section>
	}
}

templ ServerErrorPage() {
	@Base("Something broke", "An internal server error occurred") {
		<section class="error-page">
			<p class="page-subtitle">500</p>
			@PageIntro("Something broke", "Server hit a problem. Try again in a minute.")
			<a class="site-nav-link" href="/blog">Back to blog</a>
		</section>
	}
}
