package web

import "github.com/danielscoffee/danielscoffee.me/internal/content"

templ PageIntro(title, subtitle string) {
	<header class="page-intro">
		<h1 class="page-title">{ title }</h1>
		<p class="page-subtitle">{ subtitle }</p>
	</header>
}

// SectionIntro opens a section index. The masthead already names the
// section, so the page heading is for screen readers only.
templ SectionIntro(title string) {
	<h1 class="sr-only">{ title }</h1>
}

templ TagPageIntro(tag string) {
	<header class="page-intro">
		<h1 class="page-title">Tagged with <span class="tag-emphasis">{ tag }</span></h1>
	</header>
}

templ BlogIndexPage(posts []content.Post) {
	@Base("Blog", "Every post on danielscoffee, newest first.", "blog") {
		@SectionIntro("Blog")
		@PostList(posts)
	}
}

// ArticleHeader shows the title, then the date and any tags on one muted
// line. Tags link to tagBase+tag ("/tag/" for posts, "/projects?tag=" for
// projects).
templ ArticleHeader(title, date string, tags []string, tagBase string) {
	<header class="article-header post-header">
		<h1 class="article-title post-title">{ title }</h1>
		if date != "" || len(tags) > 0 {
			<p class="article-meta">
				if date != "" {
					@EditorialDate(date)
				}
				for _, tag := range tags {
					<span class="article-meta-sep" aria-hidden="true">·</span>
					<a class="article-tag" href={ templ.SafeURL(tagBase + tag) }>{ tag }</a>
				}
			</p>
		}
	</header>
}

templ AboutPage(page content.Page) {
	@Base(page.Title, page.Summary, "about") {
		<article class="article-shell post-prose">
			<h1 class="sr-only">{ page.Title }</h1>
			<div class="article-body">
				@templ.Raw(string(page.BodyHTML))
			</div>
		</article>
	}
}

templ ProjectsIndexPage(projects []content.Project, tag string) {
	if tag == "" {
		@Base("Projects", "Projects and their devlogs, newest first.", "projects") {
			@SectionIntro("Projects")
			@ProjectList(projects)
		}
	} else {
		@Base("Projects tagged "+tag, "Projects on danielscoffee tagged "+tag+", with their devlogs.", "projects") {
			@TagPageIntro(tag)
			@ProjectList(projects)
		}
	}
}

// BackLink sits above a post, project, or devlog: the masthead's drawn arrow
// alone. page-back.js sends it to the previous page when that page was on
// this site; otherwise href leads to the parent listing.
templ BackLink(href templ.SafeURL) {
	<div class="page-breadcrumb">
		<a class="page-back" href={ href } aria-label="Back">
			<svg class="page-back-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M14 8H2.5"></path><path d="M7 3.5 2.5 8 7 12.5"></path></svg>
		</a>
	</div>
}

templ ProjectDetailPage(project content.Project) {
	@Base(project.Title, project.Summary, "projects") {
		@BackLink("/projects")
		<article class="article-shell post-prose">
			@ArticleHeader(project.Title, project.Date, project.Tags, "/projects?tag=")
			<div class="article-body">
				@templ.Raw(string(project.BodyHTML))
			</div>
		</article>
		if len(project.SubPosts) > 0 {
			<section class="section-block">
				<h2 class="section-title">Devlog &amp; notes</h2>
				@DevlogList(project)
			</section>
		}
	}
}

// DevlogList is the flat list of a project's devlogs: the title, then a
// muted "Oct 10, 2026 · 3 min". No year marks, cards, or summaries.
templ DevlogList(project content.Project) {
	<ul class="entry-list devlog-list">
		for _, sub := range project.SubPosts {
			<li class="entry devlog-item">
				<a class="entry-link devlog-link" href={ templ.SafeURL("/projects/" + project.Slug + "/" + sub.Slug) }>{ sub.Title }</a>
				<span class="entry-meta"><time datetime={ sub.Date }>{ longDate(sub.Date) }</time> · { readingTime(sub.BodyMD) }</span>
			</li>
		}
	</ul>
}

templ ProjectSubPostPage(project content.Project, sub content.ProjectSubPost) {
	@Base(sub.Title, sub.Summary, "projects") {
		@BackLink(templ.SafeURL("/projects/" + project.Slug))
		<article class="article-shell post-prose">
			@ArticleHeader(sub.Title, sub.Date, nil, "")
			<div class="article-body">
				@templ.Raw(string(sub.BodyHTML))
			</div>
			@templ.JSONScript("article-data", blogPostingJSONLD(ctx, sub.Title, sub.Date)).WithType("application/ld+json")
		</article>
	}
}

templ TagPage(tag string, posts []content.Post) {
	@Base("Posts tagged "+tag, "Posts on danielscoffee tagged "+tag+".", "blog") {
		@TagPageIntro(tag)
		if len(posts) == 0 {
			<p class="empty-state">No posts found for this tag yet.</p>
		} else {
			@PostList(posts)
		}
	}
}

templ EditorialDate(date string) {
	<time class="editorial-date" datetime={ date }>{ date }</time>
}

// PostList is a flat, year-grouped list in the antfu.me style: the title,
// then a muted "Oct 10 · 6 min". No summaries, tags, or cards.
templ PostList(posts []content.Post) {
	<div class="year-list post-list">
		for _, group := range postsByYear(posts) {
			<section class="year-group" aria-labelledby={ "year-" + group.Year }>
				<h2 class="year-mark" id={ "year-" + group.Year }>{ group.Year }</h2>
				<ul class="entry-list">
					for _, post := range group.Posts {
						<li class="entry post-item">
							<a class="entry-link post-link" href={ templ.SafeURL("/post/" + post.Slug) }>{ post.Title }</a>
							<span class="entry-meta"><time datetime={ post.Date }>{ shortDate(post.Date) }</time> · { readingTime(post.BodyMD) }</span>
						</li>
					}
				</ul>
			</section>
		}
	</div>
}

templ ProjectList(projects []content.Project) {
	if len(projects) == 0 {
		<p class="empty-state">No projects found for this tag yet.</p>
	} else {
		<div class="year-list project-list">
			for _, group := range projectsByYear(projects) {
				<section class="year-group" aria-labelledby={ "year-" + group.Year }>
					<h2 class="year-mark" id={ "year-" + group.Year }>{ group.Year }</h2>
					<ul class="entry-list">
						for _, project := range group.Projects {
							<li class="entry project-item">
								<a class="entry-link project-link" href={ templ.SafeURL("/projects/" + project.Slug) }>{ project.Title }</a>
								<span class="entry-meta"><time datetime={ project.Date }>{ shortDate(project.Date) }</time></span>
							</li>
						}
					</ul>
				</section>
			}
		</div>
	}
}

templ BlogPostPage(post content.Post) {
	@Base(post.Title, post.Summary, "blog") {
		@BackLink("/blog")
		<article class="article-shell post-prose">
			@ArticleHeader(post.Title, post.Date, post.Tags, "/tag/")
			<div class="article-body">
				@templ.Raw(string(post.BodyHTML))
			</div>
			@templ.JSONScript("article-data", blogPostingJSONLD(ctx, post.Title, post.Date)).WithType("application/ld+json")
		</article>
	}
}

templ NotFoundPage() {
	@Base("Page not found", "The requested page could not be found", "") {
		<section class="error-page">
			<p class="page-subtitle">404</p>
			@PageIntro("Page not found", "This page wandered off, or the link is wrong.")
			<a class="site-nav-link" href="/blog">Back to blog</a>
		</section>
	}
}

templ ServerErrorPage() {
	@Base("Something broke", "An internal server error occurred", "") {
		<section class="error-page">
			<p class="page-subtitle">500</p>
			@PageIntro("Something broke", "Server hit a problem. Try again in a minute.")
			<a class="site-nav-link" href="/blog">Back to blog</a>
		</section>
	}
}
